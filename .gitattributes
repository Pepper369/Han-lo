# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Denote all binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
